# Experiment 21 variant C: variant B plus octal PSRAM ECC (1/16 of PSRAM reserved, MSPI
# error-correcting code). The integrity lever that does NOT depend on the flash vendor.
# (120 MHz SDR), PSRAM in 120 MHz DDR. No temperature retune: measured on this
# board, IDF's retune init aborts the boot because the flash vendor (0xC2
# Macronix) is not in its verified allowlist ({0xC8, 0x20}).
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y
CONFIG_ESPTOOLPY_FLASHFREQ_120M=y
CONFIG_SPIRAM_SPEED_120M=y
CONFIG_SPIRAM_ECC_ENABLE=y
