diff --git a/host/nd_dump.c b/host/nd_dump.c
index 93fba45..f9fac40 100644
--- a/host/nd_dump.c
+++ b/host/nd_dump.c
@@ -41,6 +41,74 @@ __attribute__((destructor)) static void nd_exp_cap_dtor(void)
 {
     if (s_capf) { fwrite(s_cap, sizeof(float), s_capn, s_capf); fclose(s_capf); s_capf = NULL; }
 }
+
+/* Experiment 22 fixture: the mHC phi (4-bit generic path) GEMV exactly as the
+ * shipping kernel saw it. One record per call to $ND_PHI4CAP:
+ *   header | codebook[1<<bits] | xh[in_pad] | y[nrows] |
+ *   per selected row: absolute row index, packed row_bytes, norms[ngroup] fp16
+ * Rows are stored with their ABSOLUTE tensor row index because the phi tensors
+ * stack all layers and the kernel is handed a row base (gemv_rows_offset).
+ * The norms follow the whole packed block, exactly as nd_cq_gemv_rows computes
+ * them: norms = packed + t->shape[0] * row_bytes. */
+#define ND_PHI4_MAGIC 0x34465048u   /* 'HPF4' */
+#define ND_PHI4_MAX   24
+#define ND_PHI4_ROWS  8
+typedef struct {
+    uint32_t magic, seq, out, in_pad, group, bits, ngroup, rowbytes, nsel, row0, nrows;
+} nd_phi4_rec;
+
+static FILE    *s_phi4f;
+static uint32_t s_phi4n, s_phi4call, s_phi4skip = ~(uint32_t)0;
+
+void nd_phi4_capture(const nd_cact *c, const nd_tensor *t, const void *blob,
+                     const float *xh, uint32_t row0, uint32_t nrows, const float *y)
+{
+    nd_phi4_rec r;
+    uint32_t     i;
+
+    if (s_phi4skip == ~(uint32_t)0) {
+        const char *e = getenv("ND_PHI4CAP");
+        const char *s = getenv("ND_PHI4SKIP");
+        if (!e || !*e) { s_phi4skip = 0; return; }
+        s_phi4skip = s ? (uint32_t)strtoul(s, NULL, 10) : 0;
+        s_phi4f = fopen(e, "wb");
+        if (!s_phi4f) { s_phi4skip = 0; return; }
+    }
+    if (s_phi4call++ < s_phi4skip || s_phi4n >= ND_PHI4_MAX) return;
+
+    memset(&r, 0, sizeof r);
+    r.magic   = ND_PHI4_MAGIC;
+    r.seq     = s_phi4n;
+    r.out     = t->shape[0];
+    r.in_pad  = nd_cq_in_pad(t);
+    r.group   = t->group;
+    r.bits    = t->bits;
+    r.ngroup  = nd_cq_groups(t);
+    r.rowbytes = nd_cq_row_bytes(t);
+    r.row0    = row0;
+    r.nrows   = nrows;
+    r.nsel    = nrows <= ND_PHI4_ROWS ? nrows : ND_PHI4_ROWS;
+    fwrite(&r, sizeof r, 1, s_phi4f);
+    fwrite(nd_cact_codebook(c, t->bits), sizeof(float), 1u << t->bits, s_phi4f);
+    fwrite(xh, sizeof(float), r.in_pad, s_phi4f);
+    fwrite(y, sizeof(float), nrows, s_phi4f);
+    for (i = 0; i < r.nsel; i++) {
+        uint32_t row = r.nsel == nrows ? i : (uint32_t)((uint64_t)i * nrows / r.nsel);
+        const uint8_t *rp = (const uint8_t *)blob + (size_t)(row0 + row) * r.rowbytes;
+        const uint8_t *np = (const uint8_t *)blob + (size_t)r.out * r.rowbytes +
+                            (size_t)(row0 + row) * r.ngroup * 2;
+        fwrite(&row, sizeof row, 1, s_phi4f);
+        fwrite(rp, 1, r.rowbytes, s_phi4f);
+        fwrite(np, 1, (size_t)r.ngroup * 2, s_phi4f);
+    }
+    fflush(s_phi4f);
+    s_phi4n++;
+}
+
+__attribute__((destructor)) static void nd_phi4_cap_dtor(void)
+{
+    if (s_phi4f) { fclose(s_phi4f); s_phi4f = NULL; }
+}
 #endif
 
 
