@@ -3515,7 +3735,11 @@ int kbench_run(void)
     bench_gather();
     bench_wake();
     bench_rowrange();
-#if ND_KB_EXP38
+#if ND_KB_EXP36
+    bench_e36();
+#elif ND_KB_EXP37
