+/* Three groups in one stage walk.
+ *
+ * The accepted win here (run #379) is two chains in flight inside a transform whose
+ * butterflies are a long serial dependency with nothing else to overlap, and run #382
+ * showed the within-stage unroll and the pairing are ONE mechanism, not two. The
+ * remaining question was how far the group count goes, and the geometry answers it:
+ * ngroup is 6 and the device splits it 3+3, so each core owns EXACTLY THREE groups -
+ * which means a three-wide walk covers a whole per-core call and the single-group
+ * path below stops executing in the field entirely (a four-wide walk would never run
+ * here at all, and would have silently re-measured the accepted path).
+ *
+ * Bit-exact by construction, for the same reason nd_fwht2 is: a group's stages
+ * complete in its own order, butterflies within a stage are disjoint pairs, and the
+ * three chains never touch each other's elements. */
+static ND_HOT void nd_fwht3(float *x0, float *x1, float *x2, uint32_t n)
+{
+    uint32_t len, step, base, j;
+
+    for (len = 1u; len < n; len <<= 1) {
+        step = len << 1;
+        for (base = 0u; base + step <= n; base += step) {
+            const uint32_t half = base + len;
+            for (j = base; j + 1u < half; j += 2u) {
+                float a0 = x0[j], b0 = x0[j + len], a1 = x0[j + 1u], b1 = x0[j + 1u + len];
+                float c0 = x1[j], d0 = x1[j + len], c1 = x1[j + 1u], d1 = x1[j + 1u + len];
+                float e0 = x2[j], f0 = x2[j + len], e1 = x2[j + 1u], f1 = x2[j + 1u + len];
+
+                x0[j] = a0 + b0;          x0[j + len] = a0 - b0;
+                x0[j + 1u] = a1 + b1;     x0[j + 1u + len] = a1 - b1;
+                x1[j] = c0 + d0;          x1[j + len] = c0 - d0;
+                x1[j + 1u] = c1 + d1;     x1[j + 1u + len] = c1 - d1;
+                x2[j] = e0 + f0;          x2[j + len] = e0 - f0;
+                x2[j + 1u] = e1 + f1;     x2[j + 1u + len] = e1 - f1;
+            }
+            if (j < half) {
+                float a = x0[j], b = x0[j + len];
+                float c = x1[j], d = x1[j + len];
+                float e = x2[j], f = x2[j + len];
+
+                x0[j] = a + b; x0[j + len] = a - b;
+                x1[j] = c + d; x1[j + len] = c - d;
+                x2[j] = e + f; x2[j + len] = e - f;
+            }
+        }
+    }
+}
