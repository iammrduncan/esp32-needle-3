+                        for (k = 0; k < n; k++)
+                            p[k] = nd_f16(h[k]);
+                    }
                     p += n;
                 }
         }
@@ -1713,7 +1726,10 @@ static ND_HOT void cond_rows(void *vc, uint32_t c0, uint32_t c1)
     for (ch = c0; ch < c1; ch++) {
         float acc = 0.0f;
         for (i = 0; i < c->dm; i++)
-            acc += c->x[i] * c->cv[(size_t)i * 8 + ch];
+            /* cv is staged channel-major (see the fp16 pool fill): channel ch is one
+             * contiguous 3 KB row now, so this sweep is sequential. The term order and
+             * the accumulator are exactly the shipped ones, so the sum is identical. */
+            acc += c->x[i] * c->cv[(size_t)ch * c->dm + i];
         c->dst[ch] = acc;
     }
 }
