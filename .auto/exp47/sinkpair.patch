+             * an odd lane count so the function stays correct for other n. */
+            for (j = 0; j + 1u < n; j += 2u)
+                sink_term_pair(a[i * n + j] - mx, a[i * n + j + 1u] - mx, &sum);
+            for (; j < n; j++) {
                 float d = a[i * n + j] - mx;
                 sum += (d == 0.0f) ? 1.0f : nd_expf(d);
             }
