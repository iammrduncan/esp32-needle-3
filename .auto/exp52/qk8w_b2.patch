+#if defined(ND_GEMV4_ASM)
+extern void nd_qk_dot8w(const float *qa, const float *qb, const float *k0,
+                        const float *k1, uint32_t nchunk, float *out);
+
+/* E52: the wide-load twin of the DOT8W body, accepted only where it PROVES it
+ * reproduces the statements it replaces. Its whole contract is bit-exactness -
+ * the inner pair product is contracted and the accumulator add is not, so a
+ * hand-chosen 4-FMA chain would round every score differently - which is why the
+ * kernel is not trusted on inspection: one differential run on this silicon, over
+ * this engine's own statement text, before the attention loop may call it. The
+ * reference below is the shipping loop verbatim; the values are drawn from the
+ * two ranges the field actually produces (staged int8 as float is exact to 127,
+ * post-RMSNorm/RoPE query floats are O(1)) plus exact zeros, denormals and large
+ * magnitudes, so an order change cannot hide in a narrow range. 256 trials cost
+ * ~1 kB of stack once per model open and nothing on the timed path. */
+static uint32_t qk8_rnd(uint32_t *st)
+{
+    uint32_t s = *st;
+    s ^= s << 13; s ^= s >> 17; s ^= s << 5;
+    *st = s;
+    return s;
+}
+
+static int qk8_selftest(void)
+{
+    static const float scale[4] = { 1.0f, 0.0037f, 37.0f, 1.0e-6f };
+    float qa[48] __attribute__((aligned(16)));
+    float qb[48] __attribute__((aligned(16)));
+    float k0[48] __attribute__((aligned(16)));
+    float k1[48] __attribute__((aligned(16)));
+    float got[4];
+    uint32_t trial, bad = 0, i, u;
+    uint32_t st = 0x9e3779b9u;
+
+    for (trial = 0; trial < 256u; trial++) {
+        float sc = scale[trial & 3u];
+        float s0 = 0.0f, s1 = 0.0f, s0b = 0.0f, s1b = 0.0f;
+
+        for (u = 0; u < 48u; u++) {
+            /* every 8th entry is a corner value the random walk cannot make */
+            if ((trial & 7u) == 0u && (u & 7u) == 0u) {
+                qa[u] = 0.0f; qb[u] = -0.0f; k0[u] = 1.0e-30f; k1[u] = 0.0f;
+            } else if ((trial & 11u) == 3u && (u & 5u) == 1u) {
+                qa[u] = 1.0e30f; qb[u] = -1.0e30f; k0[u] = sc; k1[u] = -sc;
+            } else {
+                qa[u] = (float)((int)(qk8_rnd(&st) >> 20) % 2001 - 1000) * 0.0011f * sc;
+                qb[u] = (float)((int)(qk8_rnd(&st) >> 20) % 2001 - 1000) * 0.0013f * sc;
+                k0[u] = (float)((int)(qk8_rnd(&st) >> 20) % 255  - 127) * 0.71f;
+                k1[u] = (float)((int)(qk8_rnd(&st) >> 20) % 255  - 127) * 0.83f;
+            }
+        }
+        /* the shipping statements, verbatim */
+        for (i = 0; i + 7u < 48u; i += 8u) {
+            s0  += qa[i]     * k0[i]     + qa[i + 1u] * k0[i + 1u];
+            s0  += qa[i + 2u] * k0[i + 2u] + qa[i + 3u] * k0[i + 3u];
+            s0  += qa[i + 4u] * k0[i + 4u] + qa[i + 5u] * k0[i + 5u];
+            s0  += qa[i + 6u] * k0[i + 6u] + qa[i + 7u] * k0[i + 7u];
+            s1  += qa[i]     * k1[i]     + qa[i + 1u] * k1[i + 1u];
+            s1  += qa[i + 2u] * k1[i + 2u] + qa[i + 3u] * k1[i + 3u];
+            s1  += qa[i + 4u] * k1[i + 4u] + qa[i + 5u] * k1[i + 5u];
+            s1  += qa[i + 6u] * k1[i + 6u] + qa[i + 7u] * k1[i + 7u];
+            s0b += qb[i]     * k0[i]     + qb[i + 1u] * k0[i + 1u];
+            s0b += qb[i + 2u] * k0[i + 2u] + qb[i + 3u] * k0[i + 3u];
+            s0b += qb[i + 4u] * k0[i + 4u] + qb[i + 5u] * k0[i + 5u];
+            s0b += qb[i + 6u] * k0[i + 6u] + qb[i + 7u] * k0[i + 7u];
+            s1b += qb[i]     * k1[i]     + qb[i + 1u] * k1[i + 1u];
+            s1b += qb[i + 2u] * k1[i + 2u] + qb[i + 3u] * k1[i + 3u];
+            s1b += qb[i + 4u] * k1[i + 4u] + qb[i + 5u] * k1[i + 5u];
+            s1b += qb[i + 6u] * k1[i + 6u] + qb[i + 7u] * k1[i + 7u];
+        }
+        nd_qk_dot8w(qa, qb, k0, k1, 12u, got);
+        if (memcmp(&s0, &got[0], 4) != 0 || memcmp(&s1, &got[1], 4) != 0 ||
+            memcmp(&s0b, &got[2], 4) != 0 || memcmp(&s1b, &got[3], 4) != 0)
+            bad++;
+    }
+    printf("QK8W selftest trials=256 bad=%u\n", (unsigned)bad);
+    return bad == 0;
+}
