/* nd_qk_dot8w - E52: the wide-load form of the DOT8W attention QK body.
 *
 * void nd_qk_dot8w(const float *qa, const float *qb, const float *k0,
 *                  const float *k1, uint32_t nchunk, float *out);
 *   a2 qa, a3 qb, a4 k0, a5 k1, a6 nchunk (= qk_hd/4, must be >= 1), a7 out
 *   out[0] = qa.k0   out[1] = qa.k1   out[2] = qb.k0   out[3] = qb.k1
 *
 * The four accumulators are advanced in chunks of FOUR floats in exactly the
 * order the shipped body has: for one accumulator the step is
 *     t = p[k+1]*w[k+1]; t = madd(p[k], w[k], t); s = s + t;
 * twice per chunk, chunk-ascending. That is not a chosen reduction, it is what
 * GCC -O2 -ffp-contract=fast emits for `s += p[k]*w[k] + p[k+1]*w[k+1]`: the
 * inner pair product is contracted and the ACCUMULATOR ADD IS NOT FUSED into it.
 * The obvious 4-FMA chain (acc = madd(p,w,acc)) rounds differently on every
 * score, and every stored golden byte depends on this order, so it is forbidden
 * rather than merely untested.
 *
 * The only change against the shipped body is operand delivery: 6 x 128-bit
 * loads per chunk replace 16 x lsi (qa, qb, k0, k1 are four floats each). k0 is
 * loaded once and consumed by both query rows, k1 likewise; each query row is
 * therefore loaded twice (once per weight row), because f0-f15 cannot hold four
 * rows plus four accumulators plus a temp. Register lists are written high-to-low
 * so the LAST-listed register gets the LOWEST address: ldf.128.ip f7,f6,f5,f4
 * leaves f4 = p[k] and f7 = p[k+3]. That order is E50's measurement; the opposite
 * list is what made run #333's probe look like lost nibble identity.
 *
 * Preconditions are the caller's: 16-byte-aligned qa/qb/k0/k1 (nd_model.c checks
 * once per head pair and keeps the C body otherwise), nchunk = qk_hd/4 with the
 * qk_hd % 4 remainder left to the C tail loop.
 */
	.align	4
	.global	nd_qk_dot8w
	.type	nd_qk_dot8w,@function
nd_qk_dot8w:
	entry	a1, 32
	movi	a8, 0
	wfr	f0, a8
	wfr	f1, a8
	wfr	f2, a8
	wfr	f3, a8
	loop	a6, .Lqkdone
.Lqkchunk:
	ee.ldf.128.ip	f7,  f6,  f5,  f4,  a4, 16	/* k0[i..i+3] */
	ee.ldf.128.ip	f11, f10, f9,  f8,  a2, 16	/* qa[i..i+3] */
	mul.s	f12, f9,  f5
	madd.s	f12, f8,  f4
	add.s	f0,  f0,  f12
	mul.s	f13, f11, f7
	madd.s	f13, f10, f6
	add.s	f0,  f0,  f13
	ee.ldf.128.ip	f11, f10, f9,  f8,  a3, 16	/* qb[i..i+3] */
	mul.s	f12, f9,  f5
	madd.s	f12, f8,  f4
	add.s	f2,  f2,  f12
	mul.s	f13, f11, f7
	madd.s	f13, f10, f6
	add.s	f2,  f2,  f13
	ee.ldf.128.ip	f7,  f6,  f5,  f4,  a5, 16	/* k1[i..i+3] */
	addi	a2, a2, -16
	ee.ldf.128.ip	f11, f10, f9,  f8,  a2, 16	/* qa[i..i+3] again */
	mul.s	f12, f9,  f5
	madd.s	f12, f8,  f4
	add.s	f1,  f1,  f12
	mul.s	f13, f11, f7
	madd.s	f13, f10, f6
	add.s	f1,  f1,  f13
	addi	a3, a3, -16
	ee.ldf.128.ip	f11, f10, f9,  f8,  a3, 16	/* qb[i..i+3] again */
	mul.s	f12, f9,  f5
	madd.s	f12, f8,  f4
	add.s	f3,  f3,  f12
	mul.s	f13, f11, f7
	madd.s	f13, f10, f6
	add.s	f3,  f3,  f13
.Lqkdone:
	ssi	f0, a7, 0
	ssi	f1, a7, 4
	ssi	f2, a7, 8
	ssi	f3, a7, 12
	retw
	.size	nd_qk_dot8w, .-nd_qk_dot8w
