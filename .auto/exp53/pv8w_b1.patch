+                     (uintptr_t)vf0 | (uintptr_t)vf1) & 15u) == 0u && v_hd >= 4u) {
+        nd_pv_pair2w(ohA, ohB, vf0, vf1, v_hd / 4u, wvA0, wvA1, wvB0, wvB1);
