 }
 
+#if defined(ND_GEMV4_ASM)
+extern void nd_fwht4w(float *x, float *x2, uint32_t n4);
+
+int nd_fwht4_ok;
+
+static uint32_t fwht4_rnd(uint32_t *st)
+{
+    uint32_t v = *st;
+    v ^= v << 13; v ^= v >> 17; v ^= v << 5;
+    *st = v;
+    return v;
+}
+
+/* The FWHT kernel's contract: every cell still gets a+b or a-b from its own two
+ * operands, computed once. The only failure mode the wide form can have is which
+ * cells the four loaded floats are, so the test runs the (len, i) shapes the field
+ * actually uses, checks every cell, and keeps a canary row past the buffer to
+ * catch a stride error. */
+static int fwht4_selftest(void)
+{
+    enum { N = 64 };
+    static float xb[N + 8] __attribute__((aligned(16)));
+    float ref[N];
+    uint32_t trial, bad = 0, i, j, len, u;
+    uint32_t st = 0x2545f491u;
+
+    for (trial = 0; trial < 64u; trial++) {
+        for (u = 0; u < N; u++) {
+            xb[u] = (float)((int)(fwht4_rnd(&st) >> 20) % 2001 - 1000) * 0.0019f;
+            ref[u] = xb[u];
+        }
+        for (u = N; u < N + 8u; u++) xb[u] = 864.25f;          /* canary */
+        for (len = 4u; len <= 16u; len <<= 1) {
+            for (i = 0; i < N; i += len << 1) {
+                for (j = 0; j < len; j++) {
+                    float a = ref[i + j], b = ref[i + j + len];
+                    ref[i + j]       = a + b;
+                    ref[i + j + len] = a - b;
+                }
+                nd_fwht4w(xb + i, xb + i + len, len >> 2);
+            }
+            for (u = 0; u < N; u++)
+                if (memcmp(&ref[u], &xb[u], 4) != 0)
+                    bad++;
+            for (u = N; u < N + 8u; u++)
+                if (xb[u] != 864.25f)
+                    bad++;                                    /* OOB store */
+        }
+    }
+    printf("FWHT4W selftest trials=64 bad=%u\n", (unsigned)bad);
+    return bad == 0;
+}
+#endif
