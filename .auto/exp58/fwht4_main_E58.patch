--- a/engine/src/gemv4_tie728.S
+++ b/engine/src/gemv4_tie728.S
@@ -183,3 +183,53 @@ nd_gemv4_rows_tie1:
 	bnez	a12, .Lrow
 	retw
 	.size	nd_gemv4_rows_tie1, .-nd_gemv4_rows_tie1
+
+/* nd_fwht4w - E58: FOUR butterflies per 128-bit load pair (FWHT stages len >= 4).
+ *
+ * void nd_fwht4w(float *x, float *x2, uint32_t n4);
+ *   a2 x (= &x[i]), a3 x2 (= &x[i+len]), a4 n4 (= len/4, >= 1)
+ *   for each 4-cell chunk: x[j+k] = a+b, x2[j+k] = a-b, k = 0..3.
+ *
+ * Run #332's screen measured 13.50 -> 11.36 cycles per butterfly (+18.78 %) for
+ * feeding these same adds/subs from wide loads, and the family was then closed on
+ * a probe that never reset its fixture. The premise is unchanged and now tested:
+ * butterflies inside one stage are disjoint, so every cell still gets exactly
+ * a+b / a-b from its own two operands - the only thing that can be wrong is which
+ * cells the four loaded floats are, and the last-named register receives the
+ * LOWEST address (TRM 1.8.25; the same order the accepted P.V and kron1 kernels
+ * use).
+ *
+ * For len >= 4 the two operand rows are each four contiguous floats, so one load
+ * pair covers four butterflies and one store pair writes them back: 8 fp ops and
+ * 4 memory ops per four butterflies instead of 8 fp ops and 16. Both stores need
+ * the rewind because stf also post-increments (TRM 1.8.65). f0-f3 hold a-b while
+ * f12-f15 hold a+b, so the 8 inputs, the 8 outputs and the two rows fit exactly
+ * in f0-f15 with no spill and no move.
+ *
+ * Caller-gated: len >= 4 (so len % 4 == 0 and every row base stays 16-byte
+ * aligned), the chunk base 16-byte aligned, and the C loop keeps len < 4.
+ */
+	.align	4
+	.global	nd_fwht4w
+	.type	nd_fwht4w,@function
+nd_fwht4w:
+	entry	a1, 32
+	loop	a4, .Lf4end
+.Lf4:
+	ee.ldf.128.ip	f7,  f6,  f5,  f4,  a2, 16	/* a0..a3 */
+	ee.ldf.128.ip	f11, f10, f9,  f8,  a3, 16	/* b0..b3 */
+	add.s	f12, f4, f8
+	add.s	f13, f5, f9
+	add.s	f14, f6, f10
+	add.s	f15, f7, f11
+	sub.s	f0,  f4, f8
+	sub.s	f1,  f5, f9
+	sub.s	f2,  f6, f10
+	sub.s	f3,  f7, f11
+	addi	a2, a2, -16
+	ee.stf.128.ip	f15, f14, f13, f12, a2, 16
+	addi	a3, a3, -16
+	ee.stf.128.ip	f3,  f2,  f1,  f0,  a3, 16
+.Lf4end:
+	retw
+	.size	nd_fwht4w, .-nd_fwht4w
