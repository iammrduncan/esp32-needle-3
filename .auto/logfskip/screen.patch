+/* ---- temporary screen (run #299): how much logf work is actually skippable? ----
+ * Two candidate mechanisms, both bit-exact by construction: (a) the banked
+ * `sum == 1.0f` skip, and (b) a memo keyed on the EXACT bits of `sum` - logf is a
+ * pure function, so identical input bits guarantee identical output bits. This
+ * block is a measurement, not a design: it is reverted, not shipped. */
+#ifdef ND_SINK_STATS
+#include <stdio.h>
+#include <string.h>
+static struct { unsigned key; int used; } g_memo[8];
+static unsigned long g_calls, g_one, g_memo_hit, g_exp_tot, g_exp_zero;
+static unsigned g_dist[8192]; static unsigned g_dist_n;
+static void sink_stat(float sum, int zero_exps)
+{
+    unsigned k;
+    memcpy(&k, &sum, 4);
+    g_calls++;
+    g_exp_tot += 4; g_exp_zero += (unsigned)zero_exps;
+    if (sum == 1.0f) g_one++;
+    { unsigned slot = (unsigned)(((unsigned long)k * 2654435761UL) >> 29) & 7U;
+      if (g_memo[slot].used && g_memo[slot].key == k) g_memo_hit++;
+      else { g_memo[slot].key = k; g_memo[slot].used = 1; } }
+    { unsigned i; for (i = 0; i < g_dist_n; i++) if (g_dist[i] == k) break;
+      if (i == g_dist_n && g_dist_n < 8192) g_dist[g_dist_n++] = k; }
+}
+__attribute__((destructor)) static void sink_stat_dump(void)
+{
+    fprintf(stderr, "SINKSTAT calls=%lu sum_eq_1=%lu memo_hit=%lu distinct=%u "
+                    "exp_terms=%lu exp_d_zero=%lu\n",
+            g_calls, g_one, g_memo_hit, g_dist_n, g_exp_tot, g_exp_zero);
+}
+#define SINK_STAT(sum, z) sink_stat((sum), (z))
+#else
+#define SINK_STAT(sum, z) ((void)0)
+#endif
