# Both stages select the host architecture (amd64 or arm64).
ARG BASE_IMAGE=docker.io/library/node:22-bookworm
FROM docker.io/library/node:22-bookworm AS node
FROM ${BASE_IMAGE}
USER root
ARG PI_VERSION=0.84.4
ENV DEBIAN_FRONTEND=noninteractive
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && apt-get update && apt-get install -y --no-install-recommends \
       bash tmux git curl ca-certificates ripgrep jq less vim-tiny \
       python3 python3-venv python3-serial build-essential procps \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && npm cache clean --force
ENV HOME=/root TERM=xterm-256color COLORTERM=truecolor PI_SKIP_VERSION_CHECK=1
COPY patch-esptool.py /usr/local/share/needle-patch-esptool.py
RUN python3 /usr/local/share/needle-patch-esptool.py
COPY needle-requirements.txt /usr/local/share/needle-requirements.txt
COPY tmux.conf /etc/tmux.conf
COPY entrypoint pi-session sync-packages.py needle-api /usr/local/bin/
RUN chmod 755 /usr/local/bin/entrypoint /usr/local/bin/pi-session /usr/local/bin/sync-packages.py /usr/local/bin/needle-api
WORKDIR /workspace
ENTRYPOINT ["/opt/esp/entrypoint.sh", "/usr/local/bin/entrypoint"]
CMD []
