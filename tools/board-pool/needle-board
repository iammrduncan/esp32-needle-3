#!/usr/bin/env python3
"""Run board-specific work in isolated checkouts with exclusive serial ownership."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys

POOL = Path('/root/board-pool')
SOURCE = Path('/workspace/esp32-needle-3')
BOARDS = {
    '1': ('flash', 'console', '90:E5:B1:D1:C0:F8', '5B91041931'),
    '2': ('board2-flash', 'board2-console', '90:E5:B1:D1:BE:B8', '5B91041804'),
    '3': ('board3-flash', 'board3-console', '90:E5:B1:D1:C1:C8', '5B91042020'),
}

def paths(board):
    flash, console, *_ = BOARDS[board]
    return Path('/dev/needle-pi') / flash, Path('/dev/needle-pi') / console

def acquire(board):
    (POOL / 'locks').mkdir(parents=True, exist_ok=True)
    lock = (POOL / 'locks' / f'board{board}.lock').open('a+')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        raise SystemExit(f'Board {board} is busy; do not bypass its lock.')
    return lock

def prepare(board):
    lock = acquire(board)
    dest = POOL / f'board{board}'
    if dest.exists():
        raise SystemExit(f'{dest} already exists; preserving its work.')
    subprocess.run(['git', 'clone', '--no-hardlinks', str(SOURCE), str(dest)], check=True)
    subprocess.run(['git', '-C', str(dest), 'switch', '-c', f'board{board}-experiments'], check=True)
    for name in ('measure.sh', 'checks.sh', 'log.jsonl'):
        shutil.copy2(SOURCE / '.auto' / name, dest / '.auto' / name)
    (dest / '.venv').symlink_to('/root/project-venv')
    (dest / 'model/needle3.cact').symlink_to(SOURCE / 'model/needle3.cact')
    (dest / '.board.json').write_text(json.dumps({
        'board': board, 'flash_serial': BOARDS[board][2], 'console_serial': BOARDS[board][3],
        'base': subprocess.check_output(['git', '-C', str(dest), 'rev-parse', 'HEAD'], text=True).strip(),
    }, indent=2) + '\n')
    print(f'Prepared {dest}; uncommitted main-workspace research was not copied.')
    lock.close()

def run(board, command):
    lock = acquire(board)
    dest = POOL / f'board{board}'
    if not dest.is_dir():
        raise SystemExit(f'Run needle-board prepare {board} first.')
    flash, console = paths(board)
    for path in (flash, console):
        if not path.exists() or not stat.S_ISCHR(path.stat().st_mode) or not os.access(path, os.R_OK | os.W_OK):
            raise SystemExit(f'{path}: unavailable; check USB and install the host serial rules.')
    env = dict(os.environ, FLASH_PORT=str(flash), SERIAL_PORT=str(console),
               NEEDLE_BOARD=board, AUTO_LOG_DIR=str(dest / '.auto/runs/current'),
               TMPDIR=str(POOL / f'tmp-board{board}'))
    Path(env['TMPDIR']).mkdir(exist_ok=True)
    # Keep the lock inherited by the command, even if this wrapper is terminated.
    activated = ['bash', '-c',
                 '. /opt/esp/idf/export.sh >/dev/null 2>&1 || exit; exec "$@"',
                 'needle-board', *command]
    result = subprocess.run(activated, cwd=dest, env=env, pass_fds=(lock.fileno(),))
    lock.close()
    return result.returncode

def main():
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument('action', choices=('list', 'prepare', 'run'))
    ap.add_argument('board', nargs='?', choices=BOARDS)
    ap.add_argument('command', nargs=argparse.REMAINDER)
    args = ap.parse_args()
    if args.action == 'list':
        for board, info in BOARDS.items():
            flash, console = paths(board)
            print(f'board{board}: flash={flash} console={console} '
                  f'connected={flash.exists() and console.exists()} '
                  f'USB={info[2]} / {info[3]} workspace={POOL / ("board" + board)}')
        return 0
    if not args.board:
        ap.error('a board number is required')
    if args.action == 'prepare':
        prepare(args.board)
        return 0
    command = args.command
    if command and command[0] == '--':
        command = command[1:]
    if not command:
        ap.error('run needs a command, e.g. run 2 -- bash .auto/measure.sh')
    return run(args.board, command)

if __name__ == '__main__':
    sys.exit(main())
