#!/usr/bin/env python3
"""Run one command concurrently in selected board workspaces, preserving each log."""
import argparse
import datetime
import json
from pathlib import Path
import subprocess
import sys

ap = argparse.ArgumentParser(description=__doc__)
ap.add_argument('--boards', default='1,2,3')
ap.add_argument('command', nargs=argparse.REMAINDER)
args = ap.parse_args()
boards = args.boards.split(',')
if not boards or len(set(boards)) != len(boards) or any(b not in ('1', '2', '3') for b in boards):
    ap.error('--boards must be a unique subset of 1,2,3')
command = args.command
if command and command[0] == '--':
    command = command[1:]
if not command:
    ap.error('supply a command after --')
stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ')
logs = Path('/root/board-pool/batches') / stamp
logs.mkdir(parents=True)
running = []
try:
    for board in boards:
        stream = (logs / f'board{board}.log').open('w')
        proc = subprocess.Popen(['/root/bin/needle-board', 'run', board, '--', *command],
                                stdout=stream, stderr=subprocess.STDOUT)
        running.append((board, proc, stream))
        print(f'board{board} started; log={stream.name}', flush=True)
    results = {}
    for board, proc, stream in running:
        results[board] = proc.wait()
        stream.close()
        print(f'board{board} exit={results[board]}', flush=True)
        for line in (logs / f'board{board}.log').read_text(errors='replace').splitlines():
            if line.startswith(('METRIC ', 'FIDELITY ', 'DIVERGE', 'ERROR', 'ERR ')):
                print(f'board{board} {line}', flush=True)
    (logs / 'results.json').write_text(json.dumps({
        'command': command, 'exit_codes': results,
    }, indent=2) + '\n')
    print(f'Batch logs: {logs}', flush=True)
    sys.exit(int(any(results.values())))
except KeyboardInterrupt:
    # Child commands inherit the terminal process group and receive Ctrl-C too.
    print('Interrupted; inspect board processes and logs before reusing them.', file=sys.stderr)
    raise
